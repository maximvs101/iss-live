# Cache policy for the built site.
#
# Copied verbatim from public/ into the root of dist/, where both Cloudflare Pages and Netlify
# read it. It lives here rather than in netlify.toml so that the policy is stated once: two hosts
# with two copies of the same rules is a seam, and the rules would have drifted the first time one
# of them was edited.
#
# The site is 113 MB and a visit that opens the Station view pulls about 22 of them, so these
# headers are not housekeeping — they are most of the bandwidth bill.

# Vite fingerprints everything it emits, so those files can be cached forever. This is what makes
# the vendor/application chunk split in vite.config worth having: three, React and the
# Lightstreamer client keep their hash across a deploy and stay in cache.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The textures are 94.5 MB of the 113, and every Station visit fetches the month's base map (4.1 MB)
# and the cloud layer (2.2 MB). Uncached, that is the single largest waste on the site — and until
# now it was uncovered, because netlify.toml named /assets, /models and /draco and stopped there.
#
# A week rather than for ever, for the same reason as the model below: these names carry no hash,
# so an immutable header would pin a visitor to whichever version they saw first. The base maps have
# already been rebuilt once.
/textures/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# The model and the Draco decoder are copied verbatim from public/, without a hash in the name. A
# week, revalidated in the background, keeps the 14.9 MB download rare without pinning anyone.
/models/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/draco/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# The entry point must not be cached, or a deploy reaches nobody: it is the only file naming the
# hashed chunks, and a stale copy points at the previous ones for as long as it lives.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# The readable pages are HTML too, and they change at every build like the entry point does:
# not fingerprinted, so not cacheable for long. Their one stylesheet is not fingerprinted either
# — a day is the compromise between re-fetching eight kilobytes and a restyle that takes a day
# to reach a returning reader.
/station/
  Cache-Control: public, max-age=0, must-revalidate

/telemetry/*
  Cache-Control: public, max-age=0, must-revalidate

/about/
  Cache-Control: public, max-age=0, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=3600

/pages.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

# Preview deployments stay out of the index.
#
# Every deploy is also served at <hash>.iss-live.pages.dev and the branch aliases, each a complete
# copy of the site. The canonical link in index.html tells a crawler which one counts; this tells
# it not to index the others at all, which is the stronger statement. The pattern matches one
# label before the project host — the hash or the branch — and not the production host itself,
# which has none.
https://:version.iss-live.pages.dev/*
  X-Robots-Tag: noindex
