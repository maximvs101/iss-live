{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iss-collector",
  "main": "src/index.js",
  "compatibility_date": "2026-08-11",

  // Once a minute: the floor Cloudflare allows, and the granularity the local collector already
  // proved sufficient — a broadcast interruption shorter than a minute is not one worth naming.
  "triggers": {
    "crons": ["* * * * *"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "iss-collector",
      "database_id": "47926b92-3a36-4237-9528-971f9baff40b"
    }
  ],

  "observability": {
    "enabled": true
  }
}
