{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iss-collector",
  "main": "src/index.js",
  "compatibility_date": "2026-08-11",

  /*
   * Stopped on 16 August 2026 and restarted the same day, for a question the first run could not
   * have been aimed at because it was not yet asked.
   *
   * The first run settled what it was built for: the two voltage levels are orbital night and day,
   * the split between arrays is a transition lag, the frozen sensors are frozen per symbol. Then
   * the array-pointing residue turned out to need something the run had been collecting all along
   * without anyone noticing — the eight gimbal angles, the two rotary joints and the measured beta
   * are exactly `verify:arrays`'s inputs, and every one of them is already in the WATCH list.
   *
   * What that buys: the off-Sun offset can be computed for every recorded minute rather than for
   * the ten samples a human happened to take by hand, and those ten fall in three clusters, which
   * is the reason the question is still open. What would settle it is a sample above 40 degrees of
   * beta — where the station is documented as deliberately off-pointing — and beta gets there on
   * its own in a few weeks. A collector already running is the difference between catching that
   * and hearing about it afterwards.
   */
  "triggers": {
    "crons": ["* * * * *"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "iss-collector",
      "database_id": "47926b92-3a36-4237-9528-971f9baff40b"
    }
  ],

  "observability": {
    "enabled": true
  }
}
