{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iss-collector",
  "main": "src/index.js",
  "compatibility_date": "2026-08-11",

  /*
   * Collection stopped on 16 August 2026, deliberately, with the worker left in place.
   *
   * It was built to settle open questions rather than to run forever, and they are settled: the two
   * voltage levels are orbital night and day, the split between arrays is a transition lag with 3A
   * consistently last, the frozen sensors are frozen per symbol rather than per module, and the
   * beta angle the site propagates matches the one the station reports to 0.039 degrees RMS over
   * 186 comparisons. What remained was surveillance, not investigation.
   *
   * An empty list rather than a deleted section, so what stopped is legible. Restoring
   * `["* * * * *"]` and redeploying starts it again; the collector itself is unchanged and its
   * five days of readings are still in D1.
   */
  "triggers": {
    "crons": []
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "iss-collector",
      "database_id": "47926b92-3a36-4237-9528-971f9baff40b"
    }
  ],

  "observability": {
    "enabled": true
  }
}
